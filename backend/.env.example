# Copy this file to .env to customize. Every setting is optional —
# the defaults below match the app behavior without a .env.
# The Settings page in the UI writes changes back to backend/.env.

# YouTube Data API v3 key (Google Cloud Console -> Credentials -> API key).
# Without a key, music filtering falls back to heuristics on titles/channels.
YOUTUBE_API_KEY=

# Daily YouTube API quota (units). videos.list costs 1 unit per call (50 videos).
YOUTUBE_DAILY_QUOTA=10000

# How many top tracks (by listens) to send to audio analysis.
# Set 0 for full coverage of all music tracks.
AUDIO_ANALYSIS_LIMIT=0

# Tracks shorter than this (seconds) are analyzed in full, longer ones — first 180 s.
ANALYZE_FULL_MAX=300

# Parallel download+analysis workers (1-4). Above 3 — higher YouTube bot-detect risk.
AUDIO_WORKERS=2

# Parallel analysis workers when audio is already cached in data/audio/ (no network).
# Bottleneck is CPU: set this roughly to your core count (cap 16).
AUDIO_WORKERS_CACHED=8

# Delete downloaded audio after analysis (true) or keep it cached in data/audio/ (false).
AUDIO_DELETE_AFTER=true

# Browser cookies for yt-dlp (YouTube usually requires sign-in for audio downloads).
# Browser name: chrome, brave, firefox, edge... Empty = no browser extraction.
# With an empty value, a manual Netscape cookies.txt placed at data/cookies.txt
# is used instead (the WSL way — see README).
AUDIO_COOKIES_FROM_BROWSER=chrome
# Keyring used to decrypt Chrome/Chromium cookies — Linux only
# (basictext, kwallet, gnomekeyring). On Windows/macOS this is ignored:
# cookies are decrypted via DPAPI/Keychain automatically.
AUDIO_COOKIES_KEYRING=basictext

# How many lyrics to look up per "Lyrics" run (LRCLIB, 1 req/s).
LYRICS_LIMIT=200
# Vocal share threshold (0-1): below it a track counts as instrumental
# and no lyrics are fetched. Must match the value in the Settings UI defaults.
LYRICS_MIN_VOCAL=0.3

# MusicBrainz requires a meaningful User-Agent with a contact address.
MB_USER_AGENT=yt-music-analyzer/1.0 (local personal project; contact: example@example.com)
MB_ENABLED=true
