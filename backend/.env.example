# YouTube Data API v3 ключ (Google Cloud Console -> Credentials -> API key).
# Без ключа фильтрация музыки работает на эвристиках по названиям/каналам.
YOUTUBE_API_KEY=

# Лимит дневной квоты YouTube API (ед.). videos.list стоит 1 ед. на вызов (50 видео).
YOUTUBE_DAILY_QUOTA=10000

# Часовой пояс для хранения времени прослушиваний (влияет на графики часов/дней).
TIMEZONE=Europe/Moscow

# Сколько треков (топ по прослушиваниям) отправлять в аудио-анализ.
# Для полного покрытия поставьте 0 = все музыкальные треки.
AUDIO_ANALYSIS_LIMIT=5

# Треки короче этого порога (сек) анализируются целиком, длиннее — первые 180 с.
ANALYZE_FULL_MAX=300

# Параллельные воркеры скачивания+анализа (1-4). Больше 3 — риск бот-детекта YouTube.
AUDIO_WORKERS=2

# Сколько текстов искать за один запуск «Тексты песен» (LRCLIB, 1 req/s).
LYRICS_LIMIT=200
# Порог доли вокала (0-1): ниже — трек считается инструменталом и текст не ищется.
LYRICS_MIN_VOCAL=0.05

# Удалять скачанное аудио после анализа (true) или держать в кэше data/audio/ (false).
AUDIO_DELETE_AFTER=false

# Cookies браузера для yt-dlp (YouTube требует авторизацию для скачивания аудио).
# Формат: имя браузера (chrome, brave, firefox...). Пусто = без cookies.
AUDIO_COOKIES_FROM_BROWSER=chrome
# Keyring для расшифровки cookies Chrome/Chromium на Linux (basictext, kwallet, gnomekeyring).
AUDIO_COOKIES_KEYRING=basictext

# Число кластеров (плейлистов по настроению). 0 = выбирать автоматически.
CLUSTER_K=0

# MusicBrainz требует осмысленный User-Agent с контактом.
MB_USER_AGENT=yt-music-analyzer/1.0 (local personal project; contact: example@example.com)
MB_ENABLED=true
